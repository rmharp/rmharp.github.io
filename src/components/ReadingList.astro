---
import reading from '../data/reading.json';
---

<section id="reading" class="container">
  <hr class="section-divider" />
  <div style="padding: 4rem 0;">
    <p class="section-label animate-in">Reading List</p>
    {reading.map((category, ci) => (
      <div class={`reading-category animate-in stagger-${Math.min(ci + 1, 4)}`}>
        <h3 class="reading-category__title">{category.category}</h3>
        <div class="reading-list">
          {category.items.map((item) => (
            <div class="reading-item">
              <a href={item.url} target="_blank" rel="noopener" class="reading-item__link">
                {item.title}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
                </svg>
              </a>
              <span class="reading-item__source">{item.source}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
