---
import projects from '../data/projects.json';

const githubIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>`;
const externalIcon = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>`;
---

<section id="projects" class="container">
  <hr class="section-divider" />
  <div style="padding: 4rem 0;">
    <p class="section-label animate-in">Projects</p>

    <div class="featured-projects">
      {projects.featured.map((project, i) => (
        <div class={`project-card animate-in stagger-${Math.min(i + 1, 4)}`}>
          <div class="project-card__header">
            <h3 class="project-card__title">{project.title}</h3>
            <div class="project-card__links">
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener" aria-label={`${project.title} GitHub`}>
                  <Fragment set:html={githubIcon} />
                </a>
              )}
              {project.external && (
                <a href={project.external} target="_blank" rel="noopener" aria-label={`${project.title} live`}>
                  <Fragment set:html={externalIcon} />
                </a>
              )}
            </div>
          </div>
          <p class="project-card__desc">{project.description}</p>
          <div class="project-card__tech">
            {project.tech.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <h3 class="other-projects-heading animate-in">Other Projects</h3>
    <div class="other-projects">
      {projects.other.map((project, i) => (
        <div class={`other-project animate-in stagger-${Math.min(i + 1, 4)}`}>
          <div class="other-project__header">
            <h4 class="other-project__title">{project.title}</h4>
            <div class="other-project__links">
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener" aria-label={`${project.title} GitHub`}>
                  <Fragment set:html={githubIcon} />
                </a>
              )}
            </div>
          </div>
          <p class="other-project__desc">{project.description}</p>
          <div class="other-project__tech">
            {project.tech.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
